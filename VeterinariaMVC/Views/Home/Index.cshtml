@{
    ViewData["Title"] = "Inicio";
}

<!-- Banner Héroe de Bienvenida -->
<div class="hero-banner">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <span class="badge bg-white text-dark mb-2 px-3 py-2 fw-semibold shadow-sm">
                <i class="fa-solid fa-star text-warning me-1"></i> Sistema de Gestión Veterinaria v1.0
            </span>
            <h1 class="hero-title">¡Bienvenido a VeterinariaMVC!</h1>
            <p class="hero-subtitle">
                Plataforma integral para el control de propietarios, mascotas, especies y razas. 
                Gestiona la información médica y administrativa con rapidez y seguridad.
            </p>
            <div class="mt-4 d-flex gap-3">
                <a asp-controller="Mascotas" asp-action="Index" class="btn btn-light text-primary btn-lg shadow-sm">
                    <i class="fa-solid fa-paw me-2"></i> Ir a Mascotas
                </a>
                <a asp-controller="Propietarios" asp-action="Index" class="btn btn-outline-light btn-lg">
                    <i class="fa-solid fa-users me-2"></i> Ver Propietarios
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Tarjetas Accesos Rápidos -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card card-hover h-100 p-3">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3 text-primary">
                    <i class="fa-solid fa-paw fa-2x"></i>
                </div>
                <div>
                    <h5 class="card-title fw-bold mb-1">Módulo Mascotas</h5>
                    <p class="card-text text-muted small mb-2">Administra registros de mascotas, fotos de perfil y razas.</p>
                    <a asp-controller="Mascotas" asp-action="Index" class="text-primary text-decoration-none fw-semibold small">
                        Gestionar <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card card-hover h-100 p-3">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3 text-success">
                    <i class="fa-solid fa-users fa-2x"></i>
                </div>
                <div>
                    <h5 class="card-title fw-bold mb-1">Módulo Propietarios</h5>
                    <p class="card-text text-muted small mb-2">Gestiona la información de contacto y clientes registrados.</p>
                    <a asp-controller="Propietarios" asp-action="Index" class="text-success text-decoration-none fw-semibold small">
                        Gestionar <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card card-hover h-100 p-3">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3 text-info">
                    <i class="fa-solid fa-shield-dog fa-2x"></i>
                </div>
                <div>
                    <h5 class="card-title fw-bold mb-1">Especies y Razas</h5>
                    <p class="card-text text-muted small mb-2">Selectores en cascada integrados para clasificación animal.</p>
                    <span class="text-muted small fw-semibold">Integrado en SPA</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Características Técnicas Destacadas -->
<div class="card p-4">
    <div class="card-body">
        <h4 class="fw-bold mb-3"><i class="fa-solid fa-code me-2 text-primary"></i>Arquitectura y Especificaciones Técnicas</h4>
        <div class="row g-3">
            <div class="col-md-6">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item bg-transparent px-0 border-0">
                        <i class="fa-solid fa-check text-success me-2"></i><strong>Arquitectura N-Capas:</strong> Separación estricta entre Data, Domain y MVC Web.
                    </li>
                    <li class="list-group-item bg-transparent px-0 border-0">
                        <i class="fa-solid fa-check text-success me-2"></i><strong>Gestión de Fotos:</strong> Subida vía <code>IFormFile</code> a <code>wwwroot/images/mascotas/</code>.
                    </li>
                </ul>
            </div>
            <div class="col-md-6">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item bg-transparent px-0 border-0">
                        <i class="fa-solid fa-check text-success me-2"></i><strong>Peticiones Asíncronas:</strong> Experiencia SPA con jQuery AJAX y DataTables en español.
                    </li>
                    <li class="list-group-item bg-transparent px-0 border-0">
                        <i class="fa-solid fa-check text-success me-2"></i><strong>Filtros y Combos:</strong> Selectores en cascada Especie &rarr; Raza e interfaz adaptativa.
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>